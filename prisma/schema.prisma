generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  STERA
  PAYPAY
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  REQUIRES_REVIEW
}

enum ShipmentCarrier {
  SAGAWA
  YAMATO
  JP_POST
}

enum ShipmentStatus {
  PENDING
  PREPARING
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

enum SmaregiSyncStatus {
  NOT_SYNCED
  PENDING
  SYNCED
  FAILED
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum EmailOutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

enum EmailTemplate {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  WELCOME
  ORDER_RECEIVED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  ORDER_CANCELLED
  SHIPMENT_SENT
  NEWSLETTER_CONTACT_SYNC
  NEWSLETTER_CAMPAIGN
  CONTACT_INQUIRY
  CONTACT_REPLY
}

enum ContactInquiryStatus {
  NEW
  IN_PROGRESS
  ANSWERED
  CLOSED
}

enum ContactInquiryMessageDirection {
  CUSTOMER
  ADMIN
}

enum NewsletterStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  SUPPRESSED
}

enum NewsletterCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PARTIAL_FAILED
  FAILED
  CANCELLED
}

enum CollectionType {
  HERO
  SEASONAL
  SHOPKEEPER
  GIFT
  BREWERY
  EDITORIAL
  STORY
}

enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
}

enum CollectionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AdminRole {
  OWNER
  MANAGER
  STAFF
}

enum SyncDirection {
  SMAREGI_TO_WEBSITE
  WEBSITE_TO_SMAREGI
}

enum SyncStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

enum SmaregiProductExclusionReason {
  OFFLINE_ONLY
}

enum SyncLogItemType {
  PRODUCT_CREATED
  PRODUCT_UPDATED
  INVENTORY_CREATED
  INVENTORY_UPDATED
  INVENTORY_ZEROED
  PRODUCT_DELETED
  PRODUCT_RETIRED
  PRODUCT_SUPPRESSED
  TAX_DEFERRED
  QUARANTINED
  ORPHAN_INVENTORY
  NEGATIVE_STOCK
}

model Category {
  id                String     @id @default(cuid())
  smaregiCategoryId String?    @unique @map("smaregi_category_id")
  parentId          String?    @map("parent_id")
  name              String
  slug              String     @unique
  displayOrder      Int        @default(0) @map("display_order")
  isActive          Boolean    @default(true) @map("is_active")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  parent            Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children          Category[] @relation("CategoryHierarchy")
  products          Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id                         String                      @id @default(cuid())
  smaregiProductId           String                      @unique @map("smaregi_product_id")
  categoryId                 String                      @map("category_id")
  productCode                String                      @map("product_code")
  janCode                    String?                     @map("jan_code")
  name                       String
  slug                       String                      @unique
  price                      Decimal                     @db.Decimal(12, 2)
  taxRate                    Decimal                     @map("tax_rate") @db.Decimal(5, 2)
  producer                   String?
  origin                     String?
  volume                     String?
  alcoholPercentage          Decimal?                    @map("alcohol_percentage") @db.Decimal(5, 2)
  description                String?
  tastingNotes               String?                     @map("tasting_notes")
  isActive                   Boolean                     @default(true) @map("is_active")
  isEcAvailable              Boolean                     @default(false) @map("is_ec_available")
  isManuallyHidden           Boolean                     @default(false) @map("is_manually_hidden")
  lastSyncedAt               DateTime?                   @map("last_synced_at")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  boxProductId               String?                     @unique @map("box_product_id")
  category                   Category                    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  boxProduct                 Product?                    @relation("ProductBoxOption", fields: [boxProductId], references: [id], onDelete: SetNull)
  boxedProduct               Product?                    @relation("ProductBoxOption")
  images                     ProductImage[]
  inventoryMirrors           InventoryMirror[]
  inventoryReservations      InventoryReservation[]
  orderItems                 OrderItem[]
  featuredCollectionProducts FeaturedCollectionProduct[]
  editorialSections          EditorialSection[]

  @@index([productCode])
  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String   @map("product_id")
  imageUrl     String   @map("image_url")
  imageType    String   @map("image_type")
  displayOrder Int      @default(0) @map("display_order")
  altText      String?  @map("alt_text")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@map("product_images")
}

model InventoryMirror {
  id                String   @id @default(cuid())
  productId         String   @map("product_id")
  smaregiStoreId    String   @map("smaregi_store_id")
  quantity          Int
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  availableQuantity Int      @map("available_quantity")
  lastSyncedAt      DateTime @map("last_synced_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, smaregiStoreId])
  @@map("inventory_mirror")
}

model Customer {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String
  nameKana                String?                  @map("name_kana")
  phone                   String?
  birthday                DateTime?
  ageConfirmedAt          DateTime?                @map("age_confirmed_at")
  smaregiCustomerId       String?                  @unique @map("smaregi_customer_id")
  passwordHash            String?                  @map("password_hash")
  emailVerifiedAt         DateTime?                @map("email_verified_at")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  addresses               CustomerAddress[]
  orders                  Order[]
  sessions                CustomerSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  contactInquiries        ContactInquiry[]

  @@map("customers")
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  customerId String    @map("customer_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  customerId String    @map("customer_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt])
  @@map("password_reset_tokens")
}

model CustomerSession {
  id         String    @id @default(cuid())
  customerId String    @map("customer_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
  @@map("customer_sessions")
}

model CustomerAddress {
  id            String   @id @default(cuid())
  customerId    String   @map("customer_id")
  postalCode    String   @map("postal_code")
  prefecture    String
  city          String
  addressLine1  String   @map("address_line1")
  addressLine2  String?  @map("address_line2")
  recipientName String   @map("recipient_name")
  phone         String
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@map("customer_addresses")
}

model Order {
  id                      String                 @id @default(cuid())
  orderNumber             String                 @unique @map("order_number")
  customerId              String                 @map("customer_id")
  status                  OrderStatus            @default(PENDING)
  paymentStatus           PaymentStatus          @default(PENDING) @map("payment_status")
  shipmentStatus          ShipmentStatus         @default(PENDING) @map("shipment_status")
  subtotal                Decimal                @db.Decimal(12, 2)
  shippingFee             Decimal                @map("shipping_fee") @db.Decimal(12, 2)
  taxAmount               Decimal                @map("tax_amount") @db.Decimal(12, 2)
  discountAmount          Decimal                @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount             Decimal                @map("total_amount") @db.Decimal(12, 2)
  paymentMethod           String                 @map("payment_method")
  shippingAddressSnapshot Json                   @map("shipping_address_snapshot")
  shippingQuoteSnapshot   Json?                  @map("shipping_quote_snapshot")
  ageConfirmedAt          DateTime?              @map("age_confirmed_at")
  smaregiOrderId          String?                @unique @map("smaregi_order_id")
  smaregiSyncStatus       SmaregiSyncStatus      @default(NOT_SYNCED) @map("smaregi_sync_status")
  orderedAt               DateTime               @default(now()) @map("ordered_at")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  customer                Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items                   OrderItem[]
  payments                Payment[]
  shipments               Shipment[]
  inventoryReservations   InventoryReservation[]
  contactInquiries        ContactInquiry[]

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                String                @id @default(cuid())
  orderId           String                @map("order_id")
  productId         String                @map("product_id")
  productName       String                @map("product_name")
  productCode       String                @map("product_code")
  unitPrice         Decimal               @map("unit_price") @db.Decimal(12, 2)
  quantity          Int
  taxRate           Decimal               @map("tax_rate") @db.Decimal(5, 2)
  subtotal          Decimal               @db.Decimal(12, 2)
  requiresTransfer  Boolean               @default(false) @map("requires_transfer")
  parentOrderItemId String?               @unique @map("parent_order_item_id")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  order             Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product           Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  parentOrderItem   OrderItem?            @relation("OrderItemBoxOption", fields: [parentOrderItemId], references: [id], onDelete: Restrict)
  boxOrderItem      OrderItem?            @relation("OrderItemBoxOption")
  reservation       InventoryReservation?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model InventoryReservation {
  id          String                     @id @default(cuid())
  productId   String                     @map("product_id")
  orderId     String                     @map("order_id")
  orderItemId String                     @unique @map("order_item_id")
  quantity    Int
  status      InventoryReservationStatus @default(ACTIVE)
  expiresAt   DateTime?                  @map("expires_at")
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")
  product     Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  order       Order                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem   OrderItem                  @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([productId, status])
  @@index([orderId, status])
  @@map("inventory_reservations")
}

model Payment {
  id                String                @id @default(cuid())
  orderId           String                @map("order_id")
  provider          PaymentProvider
  providerPaymentId String?               @map("provider_payment_id")
  idempotencyKey    String?               @unique @map("idempotency_key")
  status            PaymentStatus         @default(PENDING)
  amount            Decimal               @db.Decimal(12, 2)
  currency          String                @default("JPY") @db.VarChar(3)
  paidAt            DateTime?             @map("paid_at")
  failedAt          DateTime?             @map("failed_at")
  cancelledAt       DateTime?             @map("cancelled_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  order             Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  webhookEvents     PaymentWebhookEvent[]

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@map("payments")
}

model PaymentWebhookEvent {
  id          String          @id @default(cuid())
  provider    PaymentProvider
  eventId     String          @map("event_id")
  paymentId   String          @map("payment_id")
  payloadHash String          @map("payload_hash")
  processedAt DateTime?       @map("processed_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  payment     Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, eventId])
  @@index([paymentId])
  @@index([createdAt])
  @@map("payment_webhook_events")
}

model Shipment {
  id             String          @id @default(cuid())
  orderId        String          @map("order_id")
  carrier        ShipmentCarrier
  trackingNumber String?         @map("tracking_number")
  shippingMethod String          @map("shipping_method")
  status         ShipmentStatus  @default(PENDING)
  labelFileUrl   String?         @map("label_file_url")
  shippedAt      DateTime?       @map("shipped_at")
  deliveredAt    DateTime?       @map("delivered_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}

model FeaturedCollection {
  id                String                      @id @default(cuid())
  type              CollectionType
  season            Season?
  title             String
  subtitle          String?
  description       String?
  desktopImageUrl   String?                     @map("desktop_image_url")
  mobileImageUrl    String?                     @map("mobile_image_url")
  status            CollectionStatus            @default(DRAFT)
  publishStartAt    DateTime?                   @map("publish_start_at")
  publishEndAt      DateTime?                   @map("publish_end_at")
  displayOrder      Int                         @default(0) @map("display_order")
  createdById       String?                     @map("created_by")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  createdBy         AdminUser?                  @relation("FeaturedCollectionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  products          FeaturedCollectionProduct[]
  editorialSections EditorialSection[]

  @@index([status])
  @@index([createdById])
  @@map("featured_collections")
}

model FeaturedCollectionProduct {
  id                   String             @id @default(cuid())
  featuredCollectionId String             @map("featured_collection_id")
  productId            String             @map("product_id")
  displayOrder         Int                @default(0) @map("display_order")
  createdAt            DateTime           @default(now()) @map("created_at")
  featuredCollection   FeaturedCollection @relation(fields: [featuredCollectionId], references: [id], onDelete: Restrict)
  product              Product            @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([featuredCollectionId, productId])
  @@map("featured_collection_products")
}

model EditorialSection {
  id           String             @id @default(cuid())
  collectionId String             @map("collection_id")
  productId    String?            @map("product_id")
  title        String
  body         String
  imageUrl     String?            @map("image_url")
  displayOrder Int                @default(0) @map("display_order")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  collection   FeaturedCollection @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  product      Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([collectionId, displayOrder])
  @@index([productId])
  @@map("editorial_sections")
}

model AdminUser {
  id                         String                    @id @default(cuid())
  email                      String                    @unique
  username                   String?                   @unique
  passwordHash               String?                   @map("password_hash")
  name                       String
  role                       AdminRole                 @default(STAFF)
  isActive                   Boolean                   @default(true) @map("is_active")
  lastLoginAt                DateTime?                 @map("last_login_at")
  createdAt                  DateTime                  @default(now()) @map("created_at")
  updatedAt                  DateTime                  @updatedAt @map("updated_at")
  auditLogs                  AuditLog[]
  createdCollections         FeaturedCollection[]      @relation("FeaturedCollectionCreator")
  smaregiProductExclusions   SmaregiProductExclusion[] @relation("SmaregiProductExclusionCreator")
  createdNewsletterCampaigns NewsletterCampaign[]      @relation("NewsletterCampaignCreator")
  updatedNewsletterCampaigns NewsletterCampaign[]      @relation("NewsletterCampaignUpdater")
  assignedContactInquiries   ContactInquiry[]          @relation("ContactInquiryAssignee")
  contactInquiryMessages     ContactInquiryMessage[]   @relation("ContactInquiryMessageAuthor")
  contactInquiryNotes        ContactInquiryNote[]      @relation("ContactInquiryNoteAuthor")

  @@map("admin_users")
}

model AuditLog {
  id          String    @id @default(cuid())
  adminUserId String    @map("admin_user_id")
  action      String
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id")
  beforeData  Json?     @map("before_data")
  afterData   Json?     @map("after_data")
  ipAddress   String?   @map("ip_address")
  createdAt   DateTime  @default(now()) @map("created_at")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SyncLog {
  id              String        @id @default(cuid())
  system          String
  entityType      String        @map("entity_type")
  entityId        String        @map("entity_id")
  direction       SyncDirection
  action          String
  status          SyncStatus    @default(PENDING)
  requestPayload  Json?         @map("request_payload")
  responsePayload Json?         @map("response_payload")
  errorMessage    String?       @map("error_message")
  retryCount      Int           @default(0) @map("retry_count")
  startedAt       DateTime?     @map("started_at")
  completedAt     DateTime?     @map("completed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  items           SyncLogItem[]

  @@index([status])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("sync_logs")
}

model SyncLogItem {
  id               String          @id @default(cuid())
  syncLogId        String          @map("sync_log_id")
  type             SyncLogItemType
  smaregiProductId String?         @map("smaregi_product_id")
  productCode      String?         @map("product_code")
  productName      String?         @map("product_name")
  storeId          String?         @map("store_id")
  storeName        String?         @map("store_name")
  reason           String?
  changes          Json?
  createdAt        DateTime        @default(now()) @map("created_at")
  syncLog          SyncLog         @relation(fields: [syncLogId], references: [id], onDelete: Cascade)

  @@index([syncLogId])
  @@index([type])
  @@index([createdAt])
  @@map("sync_log_items")
}

model SmaregiProductExclusion {
  id                  String                        @id @default(cuid())
  smaregiProductId    String                        @unique @map("smaregi_product_id")
  productCode         String?                       @map("product_code")
  productNameSnapshot String?                       @map("product_name_snapshot")
  reason              SmaregiProductExclusionReason
  createdById         String?                       @map("created_by_id")
  revokedAt           DateTime?                     @map("revoked_at")
  createdAt           DateTime                      @default(now()) @map("created_at")
  updatedAt           DateTime                      @updatedAt @map("updated_at")
  createdBy           AdminUser?                    @relation("SmaregiProductExclusionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([revokedAt])
  @@map("smaregi_product_exclusions")
}

model EmailOutbox {
  id                       String                  @id @default(cuid())
  eventKey                 String                  @unique @map("event_key")
  type                     String
  recipient                String
  subject                  String
  template                 EmailTemplate
  payload                  Json
  status                   EmailOutboxStatus       @default(PENDING)
  attemptCount             Int                     @default(0) @map("attempt_count")
  nextAttemptAt            DateTime?               @default(now()) @map("next_attempt_at")
  lockedAt                 DateTime?               @map("locked_at")
  provider                 String?
  providerMessageId        String?                 @unique @map("provider_message_id")
  deliveryStatus           String?                 @map("delivery_status")
  lastError                String?                 @map("last_error")
  createdAt                DateTime                @default(now()) @map("created_at")
  sentAt                   DateTime?               @map("sent_at")
  deliveredAt              DateTime?               @map("delivered_at")
  newsletterCampaignId     String?                 @map("newsletter_campaign_id")
  newsletterSubscriptionId String?                 @map("newsletter_subscription_id")
  updatedAt                DateTime                @updatedAt @map("updated_at")
  newsletterCampaign       NewsletterCampaign?     @relation(fields: [newsletterCampaignId], references: [id], onDelete: Restrict)
  newsletterSubscription   NewsletterSubscription? @relation(fields: [newsletterSubscriptionId], references: [id], onDelete: Restrict)
  contactInquiryMessages   ContactInquiryMessage[]

  @@index([status, nextAttemptAt])
  @@index([newsletterCampaignId])
  @@index([newsletterSubscriptionId])
  @@map("email_outbox")
}

model ContactInquiry {
  id               String                  @id @default(cuid())
  submissionId     String                  @unique @map("submission_id")
  publicId         String                  @unique @map("public_id")
  status           ContactInquiryStatus    @default(NEW)
  topic            String
  name             String?
  email            String
  customerId       String?                 @map("customer_id")
  orderId          String?                 @map("order_id")
  orderNumber      String?                 @map("order_number")
  message          String
  assignedAdminId  String?                 @map("assigned_admin_id")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  firstRespondedAt DateTime?               @map("first_responded_at")
  closedAt         DateTime?               @map("closed_at")
  customer         Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order            Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assignedAdmin    AdminUser?              @relation("ContactInquiryAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages         ContactInquiryMessage[]
  notes            ContactInquiryNote[]

  @@index([status, createdAt])
  @@index([assignedAdminId, status])
  @@index([email])
  @@index([orderNumber])
  @@map("contact_inquiries")
}

model ContactInquiryMessage {
  id            String                         @id @default(cuid())
  inquiryId     String                         @map("inquiry_id")
  direction     ContactInquiryMessageDirection
  authorAdminId String?                        @map("author_admin_id")
  fromEmail     String                         @map("from_email")
  toEmail       String                         @map("to_email")
  subject       String
  body          String
  emailOutboxId String?                        @unique @map("email_outbox_id")
  createdAt     DateTime                       @default(now()) @map("created_at")
  inquiry       ContactInquiry                 @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  authorAdmin   AdminUser?                     @relation("ContactInquiryMessageAuthor", fields: [authorAdminId], references: [id], onDelete: SetNull)
  emailOutbox   EmailOutbox?                   @relation(fields: [emailOutboxId], references: [id], onDelete: SetNull)

  @@index([inquiryId, createdAt])
  @@map("contact_inquiry_messages")
}

model ContactInquiryNote {
  id        String         @id @default(cuid())
  inquiryId String         @map("inquiry_id")
  adminId   String         @map("admin_id")
  body      String
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  inquiry   ContactInquiry @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  admin     AdminUser      @relation("ContactInquiryNoteAuthor", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([inquiryId, createdAt])
  @@map("contact_inquiry_notes")
}

model EmailWebhookEvent {
  id              String   @id @default(cuid())
  providerEventId String   @unique @map("provider_event_id")
  type            String
  payloadHash     String   @map("payload_hash")
  processedAt     DateTime @default(now()) @map("processed_at")

  @@index([processedAt])
  @@map("email_webhook_events")
}

model NewsletterSubscription {
  id                   String           @id @default(cuid())
  email                String           @unique
  status               NewsletterStatus @default(SUBSCRIBED)
  consentAt            DateTime         @map("consent_at")
  unsubscribedAt       DateTime?        @map("unsubscribed_at")
  source               String
  resendContactId      String?          @map("resend_contact_id")
  unsubscribeTokenHash String           @unique @map("unsubscribe_token_hash")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  campaignOutbox       EmailOutbox[]

  @@index([status])
  @@map("newsletter_subscriptions")
}

model NewsletterCampaign {
  id               String                      @id @default(cuid())
  subject          String
  preheader        String?
  headline         String
  heroImageUrl     String?                     @map("hero_image_url")
  heroImageAlt     String?                     @map("hero_image_alt")
  body             String
  ctaLabel         String?                     @map("cta_label")
  ctaUrl           String?                     @map("cta_url")
  status           NewsletterCampaignStatus    @default(DRAFT)
  scheduledAt      DateTime?                   @map("scheduled_at")
  startedAt        DateTime?                   @map("started_at")
  completedAt      DateTime?                   @map("completed_at")
  resultSummary    String?                     @map("result_summary")
  createdByAdminId String                      @map("created_by_admin_id")
  updatedByAdminId String?                     @map("updated_by_admin_id")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")
  createdByAdmin   AdminUser                   @relation("NewsletterCampaignCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  updatedByAdmin   AdminUser?                  @relation("NewsletterCampaignUpdater", fields: [updatedByAdminId], references: [id], onDelete: SetNull)
  outbox           EmailOutbox[]
  sections         NewsletterCampaignSection[]

  @@index([status, scheduledAt])
  @@index([createdByAdminId])
  @@map("newsletter_campaigns")
}

model NewsletterCampaignSection {
  id         String             @id @default(cuid())
  campaignId String             @map("campaign_id")
  sortOrder  Int                @map("sort_order")
  imageUrl   String?            @map("image_url")
  imageAlt   String?            @map("image_alt")
  headline   String?
  body       String?
  ctaLabel   String?            @map("cta_label")
  ctaUrl     String?            @map("cta_url")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  campaign   NewsletterCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@index([campaignId, sortOrder])
  @@map("newsletter_campaign_sections")
}
