generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  STERA
  PAYPAY
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum ShipmentCarrier {
  SAGAWA
  YAMATO
  JP_POST
}

enum ShipmentStatus {
  PENDING
  PREPARING
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

enum SmaregiSyncStatus {
  NOT_SYNCED
  PENDING
  SYNCED
  FAILED
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum CollectionType {
  HERO
  SEASONAL
  SHOPKEEPER
  GIFT
  BREWERY
  EDITORIAL
  STORY
}

enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
}

enum CollectionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AdminRole {
  OWNER
  MANAGER
  STAFF
}

enum SyncDirection {
  SMAREGI_TO_WEBSITE
  WEBSITE_TO_SMAREGI
}

enum SyncStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

model Category {
  id                String     @id @default(cuid())
  smaregiCategoryId String?    @unique @map("smaregi_category_id")
  parentId          String?    @map("parent_id")
  name              String
  slug              String     @unique
  displayOrder      Int        @default(0) @map("display_order")
  isActive          Boolean    @default(true) @map("is_active")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  parent            Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children          Category[] @relation("CategoryHierarchy")
  products          Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id                         String                      @id @default(cuid())
  smaregiProductId           String                      @unique @map("smaregi_product_id")
  categoryId                 String                      @map("category_id")
  productCode                String                      @map("product_code")
  janCode                    String?                     @map("jan_code")
  name                       String
  slug                       String                      @unique
  price                      Decimal                     @db.Decimal(12, 2)
  taxRate                    Decimal                     @map("tax_rate") @db.Decimal(5, 2)
  producer                   String?
  origin                     String?
  volume                     String?
  alcoholPercentage          Decimal?                    @map("alcohol_percentage") @db.Decimal(5, 2)
  description                String?
  tastingNotes               String?                     @map("tasting_notes")
  isActive                   Boolean                     @default(true) @map("is_active")
  isEcAvailable              Boolean                     @default(false) @map("is_ec_available")
  lastSyncedAt               DateTime?                   @map("last_synced_at")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  category                   Category                    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images                     ProductImage[]
  inventoryMirrors           InventoryMirror[]
  inventoryReservations      InventoryReservation[]
  orderItems                 OrderItem[]
  featuredCollectionProducts FeaturedCollectionProduct[]
  editorialSections          EditorialSection[]

  @@index([productCode])
  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String   @map("product_id")
  imageUrl     String   @map("image_url")
  imageType    String   @map("image_type")
  displayOrder Int      @default(0) @map("display_order")
  altText      String?  @map("alt_text")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@map("product_images")
}

model InventoryMirror {
  id                String   @id @default(cuid())
  productId         String   @map("product_id")
  smaregiStoreId    String   @map("smaregi_store_id")
  quantity          Int
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  availableQuantity Int      @map("available_quantity")
  lastSyncedAt      DateTime @map("last_synced_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, smaregiStoreId])
  @@map("inventory_mirror")
}

model Customer {
  id                String            @id @default(cuid())
  email             String            @unique
  name              String
  nameKana          String?           @map("name_kana")
  phone             String?
  birthday          DateTime?
  ageConfirmedAt    DateTime?         @map("age_confirmed_at")
  smaregiCustomerId String?           @unique @map("smaregi_customer_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  addresses         CustomerAddress[]
  orders            Order[]

  @@map("customers")
}

model CustomerAddress {
  id            String   @id @default(cuid())
  customerId    String   @map("customer_id")
  postalCode    String   @map("postal_code")
  prefecture    String
  city          String
  addressLine1  String   @map("address_line1")
  addressLine2  String?  @map("address_line2")
  recipientName String   @map("recipient_name")
  phone         String
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@map("customer_addresses")
}

model Order {
  id                      String                 @id @default(cuid())
  orderNumber             String                 @unique @map("order_number")
  customerId              String                 @map("customer_id")
  status                  OrderStatus            @default(PENDING)
  paymentStatus           PaymentStatus          @default(PENDING) @map("payment_status")
  shipmentStatus          ShipmentStatus         @default(PENDING) @map("shipment_status")
  subtotal                Decimal                @db.Decimal(12, 2)
  shippingFee             Decimal                @map("shipping_fee") @db.Decimal(12, 2)
  taxAmount               Decimal                @map("tax_amount") @db.Decimal(12, 2)
  discountAmount          Decimal                @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount             Decimal                @map("total_amount") @db.Decimal(12, 2)
  paymentMethod           String                 @map("payment_method")
  shippingAddressSnapshot Json                   @map("shipping_address_snapshot")
  ageConfirmedAt          DateTime?              @map("age_confirmed_at")
  smaregiOrderId          String?                @unique @map("smaregi_order_id")
  smaregiSyncStatus       SmaregiSyncStatus      @default(NOT_SYNCED) @map("smaregi_sync_status")
  orderedAt               DateTime               @default(now()) @map("ordered_at")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  customer                Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items                   OrderItem[]
  payments                Payment[]
  shipments               Shipment[]
  inventoryReservations   InventoryReservation[]

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id               String                @id @default(cuid())
  orderId          String                @map("order_id")
  productId        String                @map("product_id")
  productName      String                @map("product_name")
  productCode      String                @map("product_code")
  unitPrice        Decimal               @map("unit_price") @db.Decimal(12, 2)
  quantity         Int
  taxRate          Decimal               @map("tax_rate") @db.Decimal(5, 2)
  subtotal         Decimal               @db.Decimal(12, 2)
  requiresTransfer Boolean               @default(false) @map("requires_transfer")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  order            Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product          Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  reservation      InventoryReservation?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model InventoryReservation {
  id          String                     @id @default(cuid())
  productId   String                     @map("product_id")
  orderId     String                     @map("order_id")
  orderItemId String                     @unique @map("order_item_id")
  quantity    Int
  status      InventoryReservationStatus @default(ACTIVE)
  expiresAt   DateTime?                  @map("expires_at")
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")
  product     Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  order       Order                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem   OrderItem                  @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([productId, status])
  @@index([orderId, status])
  @@map("inventory_reservations")
}

model Payment {
  id                String                @id @default(cuid())
  orderId           String                @map("order_id")
  provider          PaymentProvider
  providerPaymentId String?               @map("provider_payment_id")
  idempotencyKey    String?               @unique @map("idempotency_key")
  status            PaymentStatus         @default(PENDING)
  amount            Decimal               @db.Decimal(12, 2)
  paidAt            DateTime?             @map("paid_at")
  failedAt          DateTime?             @map("failed_at")
  cancelledAt       DateTime?             @map("cancelled_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  order             Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  webhookEvents     PaymentWebhookEvent[]

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@map("payments")
}

model PaymentWebhookEvent {
  id          String          @id @default(cuid())
  provider    PaymentProvider
  eventId     String          @map("event_id")
  paymentId   String          @map("payment_id")
  payloadHash String          @map("payload_hash")
  processedAt DateTime?       @map("processed_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  payment     Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, eventId])
  @@index([paymentId])
  @@index([createdAt])
  @@map("payment_webhook_events")
}

model Shipment {
  id             String          @id @default(cuid())
  orderId        String          @map("order_id")
  carrier        ShipmentCarrier
  trackingNumber String?         @map("tracking_number")
  shippingMethod String          @map("shipping_method")
  status         ShipmentStatus  @default(PENDING)
  labelFileUrl   String?         @map("label_file_url")
  shippedAt      DateTime?       @map("shipped_at")
  deliveredAt    DateTime?       @map("delivered_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}

model FeaturedCollection {
  id                String                      @id @default(cuid())
  type              CollectionType
  season            Season?
  title             String
  subtitle          String?
  description       String?
  desktopImageUrl   String?                     @map("desktop_image_url")
  mobileImageUrl    String?                     @map("mobile_image_url")
  status            CollectionStatus            @default(DRAFT)
  publishStartAt    DateTime?                   @map("publish_start_at")
  publishEndAt      DateTime?                   @map("publish_end_at")
  displayOrder      Int                         @default(0) @map("display_order")
  createdById       String?                     @map("created_by")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  createdBy         AdminUser?                  @relation("FeaturedCollectionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  products          FeaturedCollectionProduct[]
  editorialSections EditorialSection[]

  @@index([status])
  @@index([createdById])
  @@map("featured_collections")
}

model FeaturedCollectionProduct {
  id                   String             @id @default(cuid())
  featuredCollectionId String             @map("featured_collection_id")
  productId            String             @map("product_id")
  displayOrder         Int                @default(0) @map("display_order")
  createdAt            DateTime           @default(now()) @map("created_at")
  featuredCollection   FeaturedCollection @relation(fields: [featuredCollectionId], references: [id], onDelete: Restrict)
  product              Product            @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([featuredCollectionId, productId])
  @@map("featured_collection_products")
}

model EditorialSection {
  id           String             @id @default(cuid())
  collectionId String             @map("collection_id")
  productId    String?            @map("product_id")
  title        String
  body         String
  imageUrl     String?            @map("image_url")
  displayOrder Int                @default(0) @map("display_order")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  collection   FeaturedCollection @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  product      Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([collectionId, displayOrder])
  @@index([productId])
  @@map("editorial_sections")
}

model AdminUser {
  id                 String               @id @default(cuid())
  email              String               @unique
  username           String?              @unique
  passwordHash       String?              @map("password_hash")
  name               String
  role               AdminRole            @default(STAFF)
  isActive           Boolean              @default(true) @map("is_active")
  lastLoginAt        DateTime?            @map("last_login_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  auditLogs          AuditLog[]
  createdCollections FeaturedCollection[] @relation("FeaturedCollectionCreator")

  @@map("admin_users")
}

model AuditLog {
  id          String    @id @default(cuid())
  adminUserId String    @map("admin_user_id")
  action      String
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id")
  beforeData  Json?     @map("before_data")
  afterData   Json?     @map("after_data")
  ipAddress   String?   @map("ip_address")
  createdAt   DateTime  @default(now()) @map("created_at")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SyncLog {
  id              String        @id @default(cuid())
  system          String
  entityType      String        @map("entity_type")
  entityId        String        @map("entity_id")
  direction       SyncDirection
  action          String
  status          SyncStatus    @default(PENDING)
  requestPayload  Json?         @map("request_payload")
  responsePayload Json?         @map("response_payload")
  errorMessage    String?       @map("error_message")
  retryCount      Int           @default(0) @map("retry_count")
  startedAt       DateTime?     @map("started_at")
  completedAt     DateTime?     @map("completed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("sync_logs")
}
